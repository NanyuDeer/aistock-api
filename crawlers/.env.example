# 爬虫全局环境变量配置模板
# 复制为 .env 后填入实际值

# 后端 API 地址
API_BASE_URL=http://localhost:3000

# 内部接口鉴权 Token（需与后端 .env 中的 INTERNAL_API_TOKEN 一致）
INTERNAL_TOKEN=your-internal-token-here

# 数据存放目录
DATA_DIR=./data

# 日志级别
LOG_LEVEL=INFO

# Tushare Token
TUSHARE_TOKEN=

# 东方财富 API
EASTMONEY_API_BASE=https://push2.eastmoney.com

# 财联社 API
CLS_API_BASE=https://www.cls.cn

# 同花顺 API
THS_API_BASE=https://basic.10jqka.com.cn
